[Unit]
Description=GlitchCrypt screensaver idle trigger
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Reads the idle delay from ~/.config/glitchcrypt/config.ini and runs swayidle.
# glitchcrypt-settings restarts this service when the delay changes.
# In sessions where grim can't capture (GNOME, KDE) it exits quietly.
ExecStart=%h/.local/bin/glitchcrypt --idle
ExecStopPost=-/usr/bin/pkill -x glitchcrypt
Restart=on-failure

[Install]
WantedBy=graphical-session.target
