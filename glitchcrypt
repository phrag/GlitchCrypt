#!/usr/bin/env python3
"""GlitchCrypt: a Wayland screensaver that "encrypts" the text on your screen.

Takes a snapshot of the screen with grim, finds the text with tesseract OCR,
then shows a coarse, quantised, tinted version of the snapshot, with every line
of text replaced by cycling cipher glyphs. Every few seconds a short
RGB-split slice glitch runs. Only the rough layout of the screen survives, and
not even text that OCR missed can be recovered (see filtered()).

Every monitor gets its own cover window (one process each, see parent_main()).
Motion has a livelier plugged-in profile and a calmer battery profile that
switch live, and only lines that change are redrawn, to save power.

Settings live in ~/.config/glitchcrypt/config.ini (edit with
glitchcrypt-settings); command-line options override them.

    glitchcrypt                 run now, until a key, click or mouse move
    glitchcrypt --idle          run swayidle: start after the configured delay
                                (this is what glitchcrypt.service runs)
    glitchcrypt --print-config  show the effective settings as JSON

This is not a lock screen: any input closes it. Pair it with your normal
screen locker.

https://www.gnu.org/licenses/gpl-3.0.html — GPL-3.0-or-later
"""
import argparse
import configparser
import io
import json
import os
import random
import shutil
import signal
import subprocess
import sys
import time
import warnings

__version__ = "0.2.0"

os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
# SDL turns SIGTERM/SIGINT into a QUIT event by default. We want real signals:
# the parent's SIGTERM handler, and covers that die promptly when told to.
os.environ["SDL_NO_SIGNAL_HANDLERS"] = "1"
# Distro pygame builds often lack AVX2; harmless at these frame rates.
warnings.filterwarnings("ignore", message=".*avx2.*", category=RuntimeWarning)

from PIL import Image, ImageChops, ImageDraw, ImageOps  # noqa: E402

pygame = None           # imported lazily: --idle / --print-config don't need it

# ---- settings -----------------------------------------------------------------
CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "glitchcrypt", "config.ini")
SECTION = "glitchcrypt"

# key: (default, type, min, max). Out-of-range values are clamped on load.
SETTINGS = {
    "idle_minutes":    (3,       int,   1,   120),
    "tint":            ("#a9c7ff", str, None, None),
    "font":            ("monospace", str, None, None),  # family or font file
    # Motion when plugged in (livelier)...
    "fps":             (20,      int,   2,   30),
    "scramble_rate":   (3.5,     float, 0.0, 10.0),    # glyph changes/s per line
    "glitches":        (True,    bool,  None, None),
    "glitch_interval": (6.0,     float, 2.0, 60.0),    # average seconds between
    # ...and on battery (calmer, far fewer redraws). Switches live.
    "battery_fps":             (6,    int,   2,   30),
    "battery_scramble_rate":   (1.5,  float, 0.0, 10.0),
    "battery_glitches":        (True, bool,  None, None),
    "battery_glitch_interval": (15.0, float, 2.0, 60.0),
    # Background grid rows. Capped at 60 so cells stay taller than a line of
    # text on common screens: above that the background could start to leak.
    "detail":          (45,      int,   15,  60),
    "glyphs":          ("0123456789ABCDEF#$%&@*+=<>/\\|{}[]?!~^:;", str, None, None),
    # Dismissing GlitchCrypt (key, click, mouse move) locks the session first,
    # so coming back shows the lock screen instead of the desktop.
    "lock_on_dismiss": (True,    bool,  None, None),
    "lock_command":    ("loginctl lock-session auto", str, None, None),
}

LEVELS = 4              # background grey levels (with dither) — not configurable
GLITCH_TIME = 0.18
MIN_CONF = 35           # tesseract word confidence cut-off


def parse_hex(s):
    s = s.strip().lstrip("#")
    if len(s) != 6:
        raise ValueError("colour must look like #a9c7ff")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def load_config(path=CONFIG_PATH):
    """Effective settings: defaults, overridden by a valid config file."""
    cfg = {k: v[0] for k, v in SETTINGS.items()}
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(path, encoding="utf-8")
    except configparser.Error as e:
        print(f"glitchcrypt: ignoring broken {path}: {e}", file=sys.stderr)
        return cfg
    if not cp.has_section(SECTION):
        return cfg
    sec = cp[SECTION]
    for key, (default, typ, lo, hi) in SETTINGS.items():
        if key not in sec:
            continue
        try:
            if typ is bool:
                val = sec.getboolean(key)
            else:
                val = typ(sec[key])
            if lo is not None:
                val = min(hi, max(lo, val))
            if key == "tint":
                parse_hex(val)
            if key in ("glyphs", "font", "lock_command") and not val.strip():
                raise ValueError("empty")
        except ValueError:
            print(f"glitchcrypt: bad {key} in {path}, using default", file=sys.stderr)
            continue
        cfg[key] = val
    return cfg


def save_config(cfg, path=CONFIG_PATH):
    """Write settings atomically (used by glitchcrypt-settings)."""
    cp = configparser.ConfigParser(interpolation=None)
    cp[SECTION] = {k: (("true" if v else "false") if isinstance(v, bool) else str(v))
                   for k, v in cfg.items() if k in SETTINGS}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# GlitchCrypt settings (glitchcrypt-settings edits this file)\n")
        cp.write(f)
    os.replace(tmp, path)


def resolve_font(spec):
    """Font file for a family name (bold via fontconfig), or a path as-is."""
    if os.path.isfile(spec):
        return spec
    if shutil.which("fc-match"):
        out = subprocess.run(["fc-match", "-f", "%{file}", f"{spec}:bold"],
                             capture_output=True, text=True).stdout.strip()
        if out and os.path.exists(out):
            return out
    return None                                  # pygame's built-in font


def session_locked():
    """logind's LockedHint (DMS, GNOME, KDE and others set it when locked)."""
    out = subprocess.run(["loginctl", "show-session", "auto", "-p", "LockedHint",
                          "--value"], capture_output=True, text=True)
    return out.stdout.strip() == "yes"


_locked_once = False


def lock_session(cfg, wait=3.0):
    """Run the lock command, then wait (up to `wait` s) until the session
    reports locked, so the caller can keep covering the screen meanwhile."""
    global _locked_once
    if _locked_once:
        return
    _locked_once = True
    import shlex
    try:
        subprocess.run(shlex.split(cfg["lock_command"]), timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        print(f"glitchcrypt: lock command failed: {e}", file=sys.stderr)
        return
    end = time.monotonic() + wait
    while time.monotonic() < end:
        if session_locked():
            time.sleep(0.3)              # let the lock surface finish drawing
            return
        time.sleep(0.1)
    print("glitchcrypt: session didn't report locked; check lock_command",
          file=sys.stderr)


def on_battery():
    """True when running on battery (no mains/USB power online)."""
    base = "/sys/class/power_supply"
    has_battery = False
    try:
        names = os.listdir(base)
    except OSError:
        return False
    for name in names:
        try:
            with open(os.path.join(base, name, "type")) as f:
                kind = f.read().strip()
            if kind == "Battery":
                has_battery = True
                continue
            with open(os.path.join(base, name, "online")) as f:
                if kind in ("Mains", "USB", "USB_C", "USB_PD") and f.read().strip() == "1":
                    return False
        except OSError:
            continue
    return has_battery            # no battery at all (desktop) -> mains


def motion(cfg, battery):
    """The motion settings for the current power source."""
    p = "battery_" if battery else ""
    return {"fps": cfg[p + "fps"], "rate": cfg[p + "scramble_rate"],
            "glitches": cfg[p + "glitches"], "every": cfg[p + "glitch_interval"]}


def list_displays():
    """[(sdl_index, output_name or None)] for every monitor, via SDL."""
    import ctypes
    os.environ.setdefault("SDL_VIDEODRIVER", "wayland,x11")
    import pygame as pg
    pg.display.init()
    try:
        n = pg.display.get_num_displays()
        names = [None] * n
        try:
            sdl = ctypes.CDLL("libSDL2-2.0.so.0")
            sdl.SDL_GetDisplayName.restype = ctypes.c_char_p
            for i in range(n):
                raw = sdl.SDL_GetDisplayName(i) or b""
                # Wayland: "Vendor - Model - eDP-1": the connector name is last
                last = raw.decode(errors="replace").rsplit(" - ", 1)[-1].strip()
                names[i] = last or None
        except OSError:
            pass
        return list(enumerate(names))
    finally:
        pg.display.quit()


def screen_capture_works():
    """True if grim can capture here (wlroots/niri yes; GNOME/KDE no)."""
    if not shutil.which("grim"):
        return False
    return subprocess.run(["grim", "-g", "0,0 1x1", "-"], capture_output=True).returncode == 0


# ---- capture + OCR --------------------------------------------------------------
def snapshot(output=None):
    """Screen grab via grim (PPM: fast, and works with JPEG-less grim builds).
    With `output`, only that monitor; if grim doesn't know the name, all."""
    if not shutil.which("grim"):
        sys.exit("glitchcrypt: grim not found (needs a wlroots/niri-style compositor)")
    cmd = ["grim", "-t", "ppm"] + (["-o", output] if output else []) + ["-"]
    res = subprocess.run(cmd, capture_output=True)
    if res.returncode != 0 and output:
        res = subprocess.run(["grim", "-t", "ppm", "-"], capture_output=True)
    if res.returncode != 0:
        sys.exit("glitchcrypt: grim failed: " + res.stderr.decode(errors="replace").strip())
    raw = res.stdout
    return Image.open(io.BytesIO(raw)).convert("RGB")


def ocr_boxes(img):
    """Text-line boxes (x, y, w, h) from tesseract, in snapshot pixels.

    The image goes to tesseract over a pipe, so no copy of the screen ever
    touches a disk. Only boxes are kept (the recognised text is dropped), and
    words are merged into whole lines so word lengths don't show.
    """
    if not shutil.which("tesseract"):
        print("glitchcrypt: tesseract not found, nothing to encrypt", file=sys.stderr)
        return []
    buf = io.BytesIO()
    ImageOps.grayscale(img).save(buf, "PPM")        # PGM: fast, lossless
    out = subprocess.run(["tesseract", "stdin", "stdout", "--psm", "11", "tsv"],
                         input=buf.getvalue(), capture_output=True).stdout
    del buf
    lines = {}
    for row in out.decode(errors="replace").splitlines()[1:]:
        f = row.split("\t")
        if len(f) < 12 or f[0] != "5":
            continue
        try:
            x, y, w, h, conf = int(f[6]), int(f[7]), int(f[8]), int(f[9]), float(f[10])
        except ValueError:
            continue
        if conf < MIN_CONF or not any(c.isalnum() for c in f[11]) or not 6 <= h <= 160:
            continue
        key = tuple(f[1:5])                          # page, block, par, line
        x0, y0, x1, y1 = lines.get(key, (x, y, x + w, y + h))
        lines[key] = (min(x0, x), min(y0, y), max(x1, x + w), max(y1, y + h))
    del out
    return [(x0, y0, x1 - x0, y1 - y0) for x0, y0, x1, y1 in lines.values()]


# ---- image processing -------------------------------------------------------------
def cell_size(height, rows):
    return max(8, height // rows)


def filtered(img, tint, rows):
    """Background that keeps only the coarse layout of the screen.

    A blur is NOT enough: blurring is largely reversible (deconvolution) and
    blurred text can be matched by rendering + blurring guesses. Instead the
    screen is averaged down to a grid of cells taller than a text line, and each
    cell is quantised to LEVELS grey levels with random dither. Quantisation
    discards information for good; what's left is ~2 bits per cell, enough to
    say "something bright/dark is here" and no more. That grid is then
    smoothed back up for display, adding nothing new.
    """
    w, h = img.size
    cell = cell_size(h, rows)
    grid = ImageOps.grayscale(img).resize((max(1, w // cell), max(1, h // cell)),
                                          Image.BOX)
    step = 255 / (LEVELS - 1)
    grid = Image.frombytes("L", grid.size, bytes(
        int(min(LEVELS - 1, max(0, round(v / step + random.uniform(-0.5, 0.5)))) * step)
        for v in grid.tobytes()))
    soft = grid.resize((w, h), Image.BILINEAR)
    dark = tuple(max(2, int(c * 0.03)) for c in tint)
    light = tuple(int(c * 0.38) for c in tint)
    out = ImageOps.colorize(soft, dark, light).convert("RGB")
    d = ImageDraw.Draw(out, "RGBA")
    for y in range(0, out.height, 3):
        d.line([(0, y), (out.width, y)], fill=(0, 0, 0, 70))
    return out


def rgb_split(img, dx):
    r, g, b = img.split()
    return Image.merge("RGB", (ImageChops.offset(r, dx, 0), g,
                               ImageChops.offset(b, -dx, 0)))


def to_surface(img):
    return pygame.image.frombytes(img.tobytes(), img.size, "RGB").convert()


class Line:
    def __init__(self, rect, bg, glyphs):
        self.rect = rect
        # Glyph count comes from the (grid-snapped) box, never from the text.
        self.n = max(1, round(rect.w / (rect.h * 0.6)))
        self.chars = [random.choice(glyphs) for _ in range(self.n)]
        self.bg = bg


# ---- CLI --------------------------------------------------------------------------
def parse_args(cfg):
    ap = argparse.ArgumentParser(
        prog="glitchcrypt",
        description="Screensaver that scrambles the text on your screen into cipher "
                    f"glyphs. Settings: {CONFIG_PATH} (or glitchcrypt-settings).")
    ap.add_argument("--tint", default=cfg["tint"], help="colour, e.g. #a9c7ff")
    ap.add_argument("--font", default=cfg["font"], help="font family or file")
    ap.add_argument("--fps", type=int, default=None,
                    help="frame rate (default: from settings, by power source)")
    ap.add_argument("--image", help="use this image instead of a screen snapshot")
    ap.add_argument("--seconds", type=float, default=0,
                    help="quit after N seconds (default: run until input)")
    ap.add_argument("--output", metavar="PNG",
                    help="render offscreen and save the last frame (for demos); "
                         "runs --seconds (default 5)")
    ap.add_argument("--idle", action="store_true",
                    help="run swayidle with the configured delay (for the service)")
    ap.add_argument("--print-config", action="store_true",
                    help="print the effective settings as JSON and exit")
    ap.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    # internal: one cover process per monitor
    ap.add_argument("--child-display", type=int, default=None, help=argparse.SUPPRESS)
    ap.add_argument("--child-output", default=None, help=argparse.SUPPRESS)
    args = ap.parse_args()
    args.tint_hex = args.tint
    try:
        args.tint = parse_hex(args.tint)
    except ValueError as e:
        ap.error(str(e))
    if args.fps is not None:
        args.fps = min(30, max(2, args.fps))
    return args


def harden_process(name):
    """Rename the process and keep the screen snapshot inside it.

    - PR_SET_NAME: run via `env python3` the process is named python3; rename
      it so `pkill -x glitchcrypt` (used by the idle service) finds it.
    - PR_SET_DUMPABLE 0: no core dumps, and other unprivileged processes
      can't ptrace it or read /proc/<pid>/mem, where the snapshot lives.
    - RLIMIT_CORE 0: belt and braces against core dumps.
    """
    try:
        import resource
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (ImportError, ValueError, OSError):
        pass
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        libc.prctl(15, name.encode(), 0, 0, 0)          # PR_SET_NAME
        libc.prctl(4, 0, 0, 0, 0)                       # PR_SET_DUMPABLE = 0
    except (OSError, AttributeError):
        pass


def die_with_parent():
    """PR_SET_PDEATHSIG: a cover process never outlives its parent."""
    try:
        import ctypes
        ctypes.CDLL(None).prctl(1, signal.SIGTERM, 0, 0, 0)
    except (OSError, AttributeError):
        pass
    if os.getppid() == 1:            # parent already gone
        sys.exit(0)


def run_idle(cfg):
    """exec swayidle: start GlitchCrypt after the configured idle time."""
    if not screen_capture_works():
        # e.g. GNOME/KDE: exit 0 so the service doesn't restart in a loop
        print("glitchcrypt: this session doesn't allow screen capture with grim; "
              "idle trigger not started", file=sys.stderr)
        sys.exit(0)
    if not shutil.which("swayidle"):
        sys.exit("glitchcrypt: swayidle not found")
    import shlex
    me = shlex.quote(os.path.abspath(sys.argv[0]))   # swayidle runs via sh -c
    stop = "pkill -x glitchcrypt"
    os.execvp("swayidle", ["swayidle", "-w",
                           "timeout", str(cfg["idle_minutes"] * 60), me,
                           "resume", stop, "before-sleep", stop])


# ---- processes --------------------------------------------------------------------
def main():
    cfg = load_config()
    args = parse_args(cfg)
    if args.print_config:
        print(json.dumps(cfg, indent=2))
        return
    if args.idle:
        run_idle(cfg)                    # does not return
    if args.child_display is not None:
        child_main(args, cfg)
    elif args.image or args.output:
        harden_process("glitchcrypt")    # demo / test: one window, no lock
        snap = Image.open(args.image).convert("RGB") if args.image else snapshot()
        run(args, cfg, snap, ocr_boxes(snap), resolve_font(args.font))
    else:
        parent_main(args, cfg)


def parent_main(args, cfg):
    """Start one cover process per monitor; on dismiss, lock, then end them.

    Only this process is named "glitchcrypt", so swayidle's `pkill -x
    glitchcrypt` reaches it alone: the covers stay up until the lock is.
    """
    import selectors
    harden_process("glitchcrypt")
    lock = cfg["lock_on_dismiss"] and not args.seconds
    stop = {"now": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(now=True))

    try:
        displays = list_displays()
    except Exception as e:                       # noqa: BLE001 — never fail open
        print(f"glitchcrypt: couldn't list monitors ({e}); using one", file=sys.stderr)
        displays = [(0, None)]
    me = os.path.abspath(__file__)
    common = ["--tint", args.tint_hex, "--font", args.font]
    if args.fps:
        common += ["--fps", str(args.fps)]
    if args.seconds:
        common += ["--seconds", str(args.seconds)]

    children = []
    sel = selectors.DefaultSelector()
    for index, name in displays or [(0, None)]:
        cmd = [sys.executable, me, "--child-display", str(index)] + common
        if name:
            cmd += ["--child-output", name]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
        children.append(p)
        sel.register(p.stdout, selectors.EVENT_READ)

    dismissed = False
    while not dismissed:
        if stop["now"]:
            dismissed = True
            break
        for key, _ in sel.select(timeout=0.2):
            line = key.fileobj.readline()
            if line.strip() == "dismiss":
                dismissed = True
            elif not line:
                sel.unregister(key.fileobj)
        codes = [p.poll() for p in children]
        if all(c == 0 for c in codes):            # timed preview finished
            break
        if any(c not in (None, 0) for c in codes):
            dismissed = True                      # a cover crashed: fail closed

    if dismissed and lock:
        lock_session(cfg)                         # covers still up meanwhile
    for p in children:
        if p.poll() is None:
            p.terminate()
    for p in children:
        try:
            p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            p.kill()


def child_main(args, cfg):
    harden_process("glitchcrypt-out")
    die_with_parent()
    snap = snapshot(args.child_output)
    # OCR *before* the window opens, so its very first frame is already fully
    # encrypted. Until then the desktop simply stays as it is.
    boxes = ocr_boxes(snap)
    run(args, cfg, snap, boxes, resolve_font(args.font), display=args.child_display)


# ---- drawing ------------------------------------------------------------------------
def run(args, cfg, snap, boxes, font_path, display=None):
    global pygame
    offscreen = bool(args.output)
    if offscreen:
        os.environ["SDL_VIDEODRIVER"] = "dummy"
        if not args.seconds:
            args.seconds = 5
    else:
        os.environ.setdefault("SDL_VIDEODRIVER", "wayland,x11")
    # SDL/pygame inhibit idle by default (like a video player). A screensaver
    # must not: that would stop the real screen locker from ever kicking in.
    os.environ.setdefault("SDL_VIDEO_ALLOW_SCREENSAVER", "1")
    import pygame as _pygame
    pygame = _pygame

    tint, glyphs = args.tint, cfg["glyphs"]
    pygame.init()
    if os.environ["SDL_VIDEO_ALLOW_SCREENSAVER"] == "1":
        pygame.display.set_allow_screensaver(True)   # never hold an idle inhibitor
    pygame.display.set_caption("GlitchCrypt")
    if offscreen:
        screen = pygame.display.set_mode(snap.size)
    else:
        screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN,
                                         display=display or 0)
        pygame.mouse.set_visible(False)
    W, H = screen.get_size()
    sx, sy = W / snap.width, H / snap.height

    # Only the coarse, quantised background ever reaches the screen.
    filt_img = filtered(snap.resize((W, H), Image.LANCZOS), tint, cfg["detail"])
    del snap
    filt = to_surface(filt_img)
    split = to_surface(rgb_split(filt_img, max(3, W // 300)))
    del filt_img

    fonts, glyph_cache = {}, {}

    def glyph(ch, size):
        key = (ch, size)
        if key not in glyph_cache:
            if size not in fonts:
                fonts[size] = pygame.font.Font(font_path, size)
            glyph_cache[key] = fonts[size].render(ch, True, tint)
        return glyph_cache[key]

    def draw_line(ln):
        r = ln.rect
        screen.fill(ln.bg, r)
        size = max(6, int(r.h * 0.85))
        cw = r.w / ln.n
        for i, ch in enumerate(ln.chars):
            g = glyph(ch, size)
            gx = r.x + int(i * cw + (cw - g.get_width()) / 2)
            gy = r.y + (r.h - g.get_height()) // 2
            if cw < g.get_width():          # squeeze into narrow boxes
                g = pygame.transform.smoothscale(g, (max(1, int(cw)), g.get_height()))
                gx = r.x + int(i * cw)
            screen.blit(g, (gx, gy))

    lines = []
    cell = cell_size(H, cfg["detail"])
    for (x, y, w, h) in boxes:
        # widen each line to whole grid cells: line lengths are only
        # known to within a cell (several characters)
        x0 = int(x * sx) // cell * cell
        x1 = -(-int((x + w) * sx) // cell) * cell
        r = pygame.Rect(x0, int(y * sy) - 1, x1 - x0,
                        int(h * sy) + 3).clip(screen.get_rect())
        if r.w >= 3 and r.h >= 3:
            lines.append(Line(r, filt.get_at((max(0, r.x - 2), r.centery))[:3], glyphs))
    del boxes

    # Motion depends on the power source and is re-checked every few seconds.
    battery = on_battery()
    m = motion(cfg, battery)
    next_power_check = time.monotonic() + 5

    t0 = time.monotonic()
    next_glitch = t0 + random.uniform(m["every"] * 0.6, m["every"] * 1.4)
    glitch_bands, glitch_until = [], 0.0
    clock = pygame.time.Clock()
    grace_until = t0 + 2.0
    reported = False
    full = True                      # redraw everything on the next frame

    while True:
        now = time.monotonic()
        if args.seconds and now - t0 > args.seconds:
            break
        dismissed = False
        for ev in pygame.event.get():
            if ev.type in (pygame.QUIT, pygame.KEYDOWN, pygame.MOUSEBUTTONDOWN):
                dismissed = True
            elif ev.type == pygame.MOUSEMOTION and now > grace_until \
                    and abs(ev.rel[0]) + abs(ev.rel[1]) > 25:
                dismissed = True
            elif ev.type in (pygame.WINDOWEXPOSED, pygame.VIDEOEXPOSE,
                             pygame.WINDOWSIZECHANGED):
                full = True
        if dismissed:
            if display is None:
                return                   # demo/test window: just close
            if not reported:
                # tell the parent; keep covering until it has locked the session
                print("dismiss", flush=True)
                reported = True

        if now >= next_power_check:
            next_power_check = now + 5
            b = on_battery()
            if b != battery:
                battery, m, full = b, motion(cfg, b), True
        fps = args.fps or m["fps"]
        dt = 1.0 / fps

        # scramble: only lines that actually changed get redrawn
        changed = []
        for ln in lines:
            hit = False
            for i in range(ln.n):
                if random.random() < m["rate"] * dt / ln.n * 2:
                    ln.chars[i] = random.choice(glyphs)
                    hit = True
            if hit:
                changed.append(ln)

        # occasional short slice glitch
        if m["glitches"] and now >= next_glitch:
            glitch_until = now + GLITCH_TIME
            next_glitch = now + random.uniform(m["every"] * 0.6, m["every"] * 1.4)
            glitch_bands = []
            for _ in range(random.randint(2, 4)):
                bh = random.randint(H // 60, H // 14)
                by = random.randint(0, H - bh)
                dx = random.choice([-1, 1]) * random.randint(W // 80, W // 25)
                glitch_bands.append((by, bh, dx))
        glitching = now < glitch_until
        if glitch_bands and not glitching:
            glitch_bands, full = [], True        # wipe the last glitch away

        if full or glitching or offscreen:
            screen.blit(filt, (0, 0))
            for ln in lines:
                draw_line(ln)
            for by, bh, dx in (glitch_bands if glitching else []):
                band = screen.subsurface((0, by, W, bh)).copy()
                screen.blit(split, (0, by), (0, by, W, bh))
                band.set_alpha(150)
                screen.blit(band, (dx, by))
            pygame.display.flip()
            full = False
        elif changed:
            for ln in changed:
                draw_line(ln)
            pygame.display.update([ln.rect for ln in changed])
        clock.tick(fps)

    if offscreen:
        pygame.image.save(screen, args.output)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        if pygame is not None:
            pygame.quit()
